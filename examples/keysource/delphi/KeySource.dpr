library KeySource;

Uses SysUtils;

type
	Allocator = function(size: Cardinal): PAnsiChar; cdecl;

const
	key1:	AnsiString = 'Key=Zero 0x30,0x30,0x30,0x30,0x30,0x30,0x30,0x30,0x30,0x30,0x30,0x30,0x30,0x30,0x30,0x30,0x30,0x30,0x30,0x30,0x30,0x30,0x30,0x30,0x30,0x30,0x30,0x30,0x30,0x30,0x30,0x30,';
	key2:	AnsiString = 'Key=White 0x25,0x83,0x46,0x88,0xf4,0x1d,0x2c,0x69,0x48,0x53,0x7a,0x4a,0x0a,0x15,0x35,0x22,0x2c,0x02,0x4f,0x65,0xb8,0x73,0x77,0x07,0x89,0xb2,0xc6,0x04,0xda,0xe4,0x03,0x5d,';
	nl:		AnsiString = chr(10);

var
	k:		PAnsiChar;

function MakeKeys(alloc: Allocator; var size: Cardinal): PAnsiChar; cdecl; export;
begin
	size := Length(key1) + 1 + Length(key2) + 1;
	k := alloc(size);
	MakeKeys := k;

	Move(Addr(key1[1])^, k^, Length(key1));
	Inc(k, Length(key1));
	Move(Addr(nl[1])^, k^, 1);
	Inc(k);

	Move(Addr(key2[1])^, k^, Length(key2));
	Inc(k, Length(key2));
	Move(Addr(nl[1])^, k^, 1);
	Inc(k);
end;

exports
  MakeKeys;

begin

end.