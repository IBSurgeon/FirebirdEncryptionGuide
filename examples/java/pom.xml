<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>fbcrypt.examples</groupId>
  <artifactId>fbcrypt-examples</artifactId>
  <version>1.0</version>
  <packaging>pom</packaging>
  <name>Firebird encryption examples for Java</name>

  <modules>
    <module>common</module>
    <module>jdbc-basic</module>
    <module>gbak-stdin</module>
    <module>jdbc-native-keysource</module>
    <module>jdbc-native-fbcrypt</module>
  </modules>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <jaybird.version>6.0.7</jaybird.version>
    <exec.plugin.version>3.7.0</exec.plugin.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>fbcrypt.examples</groupId>
        <artifactId>common</artifactId>
        <version>${project.version}</version>
      </dependency>
      <!-- Pure Java driver: sends the key as a static value (dbCryptConfig). -->
      <dependency>
        <groupId>org.firebirdsql.jdbc</groupId>
        <artifactId>jaybird</artifactId>
        <version>${jaybird.version}</version>
      </dependency>
      <!-- Native protocol of Jaybird: works through fbclient (JNA). -->
      <dependency>
        <groupId>org.firebirdsql.jdbc</groupId>
        <artifactId>jaybird-native</artifactId>
        <version>${jaybird.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>exec-maven-plugin</artifactId>
          <version>${exec.plugin.version}</version>
          <configuration>
            <mainClass>fbcrypt.examples.Main</mainClass>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
